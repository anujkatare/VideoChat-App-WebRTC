:0},{"filePath":"63","messages":"64","suppressedMessages":"65","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"66","messages":"67","suppressedMessages":"68","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\index.js",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\App.js",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\reportWebVitals.js",[],[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\room.jsx",["69"],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\dashboard.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\home.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\auth.jsx",["70"],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\providers\\peer.jsx",["71"],[],"import React, { useMemo, useContext, useEffect, useState, useCallback } from 'react'\r\n\r\nconst PeerContext = React.createContext(null)\r\n\r\nexport const usePeer = () => useContext(PeerContext)\r\n\r\nconst PeerProvider = ({ children }) => {\r\n    const [remoteStream, setRemoteStream] = useState(null)\r\n  const peer = useMemo(() => {\r\n    return new RTCPeerConnection({\r\n      iceServers: [\r\n        { urls: 'stun:stun.l.google.com:19302' },\r\n        { urls: 'stun:global.stun.twilio.com:3478' },\r\n      ],\r\n    })\r\n  }, [])\r\n\r\n  const createOffer = async () => {\r\n    const offer = await peer.createOffer()\r\n    await peer.setLocalDescription(offer)\r\n    return offer\r\n  }\r\n\r\n  const createAnswer = async(offer) =>{\r\n    await peer.setRemoteDescription(offer)\r\n    const answer = await peer.createAnswer()\r\n    await peer.setLocalDescription(answer)\r\n    return answer\r\n  }\r\n\r\n  const setRemoteAns = async (ans) =>{\r\n    await peer.setRemoteDescription(ans)\r\n  }\r\n\r\n  const sendStream = async (stream) =>{\r\n    const tracks = stream.getTracks()\r\n    for(const track of tracks ){\r\n        peer.addTrack(track, stream)\r\n    }\r\n  }\r\n\r\n  const handleTrackEvent = useCallback((e)=>{\r\nconst streams = e.streams;\r\n   setRemoteStream(streams[0])\r\n  },[])\r\n\r\n  const handleNegotiation = useCallback(() =>{\r\n     console.log(\"Oops negotiation needed\")\r\n  },[])\r\n\r\n  useEffect(() =>{\r\n  peer.addEventListener('track',handleTrackEvent)\r\n  peer.addEventListener('negotiationneeded', handleNegotiation)\r\n  return () =>{\r\n    peer.removeEventListener('track',handleTrackEvent)\r\n    peer.removeEventListener('negotiationneeded', handleNegotiation)\r\n  }\r\n  },[handleTrackEvent,peer])\r\n\r\n\r\n  return (\r\n    <PeerContext.Provider value={{ peer, createOffer, createAnswer, setRemoteAns,  sendStream, remoteStream }}>\r\n      {children}\r\n    </PeerContext.Provider>\r\n  )\r\n}\r\n\r\nexport default PeerProvider\r\n","C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\providers\\auth.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\providers\\socket.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\lobby.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\pages\\summary.jsx",[],[],"C:\\Users\\WINDOWS 11\\Documents\\VideoChat-App-WebRTC\\client\\src\\utils\\decodeGoogleJwt.js",[],[],{"ruleId":"72","severity":1,"message":"73","line":397,"column":6,"nodeType":"74","endLine":397,"endColumn":179,"suggestions":"75"},{"ruleId":"76","severity":1,"message":"77","line":65,"column":9,"nodeType":"78","messageId":"79","endLine":65,"endColumn":27},{"ruleId":"72","severity":1,"message":"80","line":58,"column":5,"nodeType":"74","endLine":58,"endColumn":28,"suggestions":"81"},"react-hooks/exhaustive-deps","Rea